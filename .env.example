# OneBot 反向 WebSocket 服务监听地址；NapCat 中连接到 ws://127.0.0.1:8080/onebot/v11/ws
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# 智谱开放平台密钥。不要提交到仓库或发送到群聊。
ZHIPU_API_KEY=

# 本地管理后台令牌，至少16个字符。页面地址：http://127.0.0.1:8080/qq-admin
QQ_ASSISTANT_WEB_TOKEN=replace-with-a-long-random-token

# 可选：NapCat Desktop 或启动程序的完整路径。留空时请自行先启动 NapCat。
NAPCAT_START_PATH=
